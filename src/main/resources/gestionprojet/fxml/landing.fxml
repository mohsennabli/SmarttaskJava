<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox alignment="CENTER" prefHeight="740.0" prefWidth="1200.0" spacing="40.0" styleClass="app-root" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.esprit.gestionprojet.controller.LandingController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <StackPane HBox.hgrow="ALWAYS" styleClass="hero-pane">
        <VBox alignment="CENTER" spacing="16.0">
            <ImageView fitHeight="320.0" fitWidth="420.0" preserveRatio="true">
                <image>
                    <Image url="@../images/02.png" />
                </image>
            </ImageView>
            <Label styleClass="hero-title" text="SmartTask Manager" />
        </VBox>
    </StackPane>

    <VBox alignment="CENTER_LEFT" maxWidth="450.0" spacing="14.0" styleClass="panel-card" HBox.hgrow="ALWAYS">
        <Label styleClass="section-title" text="Choisissez votre profil" />
        <Label fx:id="subtitleLabel" styleClass="section-subtitle" text="Demarrer la session en mode admin ou utilisateur normal." wrapText="true" />

        <Button maxWidth="10000.0" onAction="#goAsAdmin" styleClass="btn,btn-primary" text="Entrer comme Admin" />
        <Button maxWidth="10000.0" onAction="#goAsNormalUser" styleClass="btn,btn-outline" text="Entrer comme Utilisateur" />
    </VBox>
</HBox>
