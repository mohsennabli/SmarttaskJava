<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane minHeight="600.0" minWidth="1000.0" prefHeight="720.0" prefWidth="1280.0"
            styleClass="app-root" stylesheets="@styles/styles.css" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.smarttask.controller.MyEnrollmentsController">
    <children>
        <VBox spacing="14.0" styleClass="page-container" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="18.0" left="18.0" right="18.0" top="18.0"/>
            </padding>
            <VBox spacing="16.0" styleClass="page-card" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="page-header">
                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                        <Label styleClass="section-title" text="My Enrollments"/>
                        <Label styleClass="dashboard-subtitle"
                               text="Complete formation tasks to increase progress until 100%."/>
                    </VBox>
                    <Button fx:id="backButton" onAction="#handleBack" styleClass="secondary-button" text="Back"/>
                </HBox>
                <TableView fx:id="enrollmentsTable" VBox.vgrow="ALWAYS" styleClass="table-surface">
                    <columns>
                        <TableColumn fx:id="colFormation" prefWidth="240.0" text="Formation"/>
                        <TableColumn fx:id="colStart" prefWidth="110.0" text="Start"/>
                        <TableColumn fx:id="colEnd" prefWidth="110.0" text="End"/>
                        <TableColumn fx:id="colStatut" prefWidth="120.0" text="Status"/>
                        <TableColumn fx:id="colProgress" prefWidth="200.0" text="Progress"/>
                    </columns>
                </TableView>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <Label text="Progress %" styleClass="stats-title"/>
                    <Spinner fx:id="progressSpinner" prefWidth="100.0"/>
                    <Button fx:id="updateProgressButton" onAction="#handleUpdateProgress" styleClass="primary-button"
                            text="Update Progress"/>
                    <Button fx:id="generateCertificateButton" onAction="#handleGenerateCertificate"
                            styleClass="secondary-button" text="Generate Certificate"/>
                </HBox>
                <Label styleClass="stats-title" text="Formation Tasks"/>
                <TableView fx:id="tasksTable" prefHeight="180.0" styleClass="table-surface">
                    <columns>
                        <TableColumn fx:id="colTaskTitle" prefWidth="360.0" text="Task"/>
                        <TableColumn fx:id="colTaskStatus" prefWidth="120.0" text="Status"/>
                        <TableColumn fx:id="colTaskDescription" prefWidth="420.0" text="Description"/>
                    </columns>
                </TableView>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <Button fx:id="markDoneButton" onAction="#handleMarkDone" styleClass="primary-button" text="Mark Done"/>
                    <Button fx:id="markUndoneButton" onAction="#handleMarkUndone" styleClass="secondary-button" text="Mark Undone"/>
                </HBox>
            </VBox>
        </VBox>
    </children>
</AnchorPane>
