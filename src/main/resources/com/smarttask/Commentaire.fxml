<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" alignment="TOP_CENTER"
      style="-fx-padding: 20; -fx-background-color: #1f232a;"
      stylesheets="@styles/app-theme.css"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.smarttask.controller.CommentaireController">

    <!-- Header ticket info -->
    <VBox spacing="8" style="-fx-background-color: #2b3038; -fx-padding: 15; -fx-background-radius: 14; -fx-border-color: #3d4450; -fx-border-radius: 14;" VBox.vgrow="NEVER">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="🎫" style="-fx-font-size: 22px;"/>
            <Label fx:id="ticketInfoLabel" text="Ticket #..."
                   style="-fx-text-fill: #f3f4f6; -fx-font-weight: bold; -fx-font-size: 14px;"/>
        </HBox>
        <Label fx:id="commentCountLabel" text="0 commentaire(s)"
               style="-fx-text-fill: #b9c0cb; -fx-font-size: 12px;"/>
    </VBox>

    <Label text="💬 Commentaires" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #f3f4f6;"/>

    <!-- Ajouter commentaire -->
    <VBox spacing="8" style="-fx-background-color: #2b3038; -fx-padding: 15; -fx-border-radius: 14; -fx-background-radius: 14; -fx-border-color: #3d4450;" VBox.vgrow="NEVER">
        <Label text="✍️ Nouveau commentaire" style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #e5e7eb;"/>
        <TextArea fx:id="contenuField" promptText="Écrire un commentaire..." prefHeight="80" wrapText="true"
                  style="-fx-background-color: #ffffff; -fx-text-fill: #000000; -fx-prompt-text-fill: #888888; -fx-border-color: #4b5563; -fx-border-radius: 8; -fx-padding: 8;"/>

        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button text="➕ Ajouter" onAction="#ajouterCommentaire"
                    style="-fx-background-color: #4b5563; -fx-text-fill: #f9fafb; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 20; -fx-cursor: hand;"/>
            <Button text="Supprimer" onAction="#supprimerCommentaire"
                    style="-fx-background-color: #7f1d1d; -fx-text-fill: rgb(255,255,255); -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 20; -fx-cursor: hand;"/>
            <Button text="Rafraîchir" onAction="#refresh"
                    style="-fx-background-color: #374151; -fx-text-fill: #f9fafb; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 20; -fx-cursor: hand;"/>
        </HBox>
    </VBox>

    <!-- Liste des commentaires -->
    <VBox spacing="5" VBox.vgrow="ALWAYS">
        <Label text="📝 Historique des commentaires" style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #e5e7eb;"/>

        <TableView fx:id="tableCommentaires" VBox.vgrow="ALWAYS" prefHeight="300"
                   style="-fx-background-color: #2f343e; -fx-background-radius: 10; -fx-border-color: #4b5563; -fx-border-radius: 10;">

            <columns>
                <TableColumn fx:id="colContenu" text="Commentaire" prefWidth="450"/>
                <TableColumn fx:id="colDate" text="Date" prefWidth="200"/>
            </columns>

            <placeholder>
                <VBox alignment="CENTER" spacing="10" style="-fx-padding: 30;">
                    <Label text="💬" style="-fx-font-size: 40px;"/>
                    <Label text="Aucun commentaire pour ce ticket" style="-fx-text-fill: #b9c0cb;"/>
                </VBox>
            </placeholder>
        </TableView>
    </VBox>

</VBox>