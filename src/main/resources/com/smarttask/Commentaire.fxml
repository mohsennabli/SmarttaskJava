<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" alignment="TOP_CENTER"
      style="-fx-padding: 20; -fx-background-color: #f0f2f5;"
      stylesheets="@styles/app-theme.css"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.smarttask.controller.CommentaireController">

    <!-- Header ticket info -->
    <VBox spacing="5" style="-fx-background-color: #4361ee; -fx-padding: 12; -fx-background-radius: 12;" VBox.vgrow="NEVER">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="🎫" style="-fx-font-size: 20px;"/>
            <Label fx:id="ticketInfoLabel" text="Ticket #..."
                   style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;"/>
        </HBox>
        <Label fx:id="commentCountLabel" text="0 commentaire(s)"
               style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 12px;"/>
    </VBox>

    <Label text="💬 Commentaires" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

    <!-- Ajouter commentaire -->
    <VBox spacing="8" style="-fx-background-color: white; -fx-padding: 15; -fx-border-radius: 12; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 1);" VBox.vgrow="NEVER">
        <Label text="✍️ Nouveau commentaire" style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #2c3e50;"/>
        <TextArea fx:id="contenuField" promptText="Écrire un commentaire..." prefHeight="80" wrapText="true"/>

        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button text="➕ Ajouter" onAction="#ajouterCommentaire"
                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 20; -fx-cursor: hand;"/>
            <Button text="🗑️ Supprimer" onAction="#supprimerCommentaire"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 20; -fx-cursor: hand;"/>
            <Button text="🔄 Rafraîchir" onAction="#refresh"
                    style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 20; -fx-cursor: hand;"/>
        </HBox>
    </VBox>

    <!-- Liste des commentaires -->
    <VBox spacing="5" VBox.vgrow="ALWAYS">
        <Label text="📝 Historique des commentaires" style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #2c3e50;"/>

        <TableView fx:id="tableCommentaires" VBox.vgrow="ALWAYS" prefHeight="300">
            <columns>
                <TableColumn fx:id="colContenu" text="Commentaire" prefWidth="450"/>
                <TableColumn fx:id="colDate" text="Date" prefWidth="200"/>
            </columns>
            <placeholder>
                <VBox alignment="CENTER" spacing="10" style="-fx-padding: 30;">
                    <Label text="💬" style="-fx-font-size: 48px;"/>
                    <Label text="Aucun commentaire pour ce ticket" style="-fx-text-fill: #7f8c8d;"/>
                </VBox>
            </placeholder>
        </TableView>
    </VBox>

</VBox>