<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="0" styleClass="root-container" stylesheets="@styles/app-theme.css"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.smarttask.controller.TicketController">

    <!-- ========== HEADER ========== -->
    <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: #171a1f; -fx-padding: 15 25; -fx-border-color: #3d4450; -fx-border-width: 0 0 1 0;">
        <Label text="🎫" style="-fx-font-size: 28px;"/>
        <Label text="SmartTask" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #f3f4f6;"/>
        <Label text="Dashboard" style="-fx-text-fill: #b9c0cb; -fx-font-size: 14px;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="👤 Admin" style="-fx-background-color: #4b5563; -fx-text-fill: #f9fafb; -fx-background-radius: 20; -fx-padding: 6 16; -fx-cursor: hand;"/>
    </HBox>

    <HBox spacing="0" VBox.vgrow="ALWAYS">

        <!-- ========== MENU LATÉRAL ========== -->
        <VBox spacing="5" prefWidth="220" style="-fx-background-color: #1f232a; -fx-padding: 20 0;">

            <Label text="MENU PRINCIPAL" style="-fx-font-size: 11px; -fx-text-fill: #9ca3af; -fx-padding: 0 20 10 20;"/>

            <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-padding: 10 20; -fx-background-color: #4b5563; -fx-border-radius: 0 20 20 0; -fx-cursor: hand;">
                <Label text="🏠" style="-fx-font-size: 16px;"/>
                <Label text="Dashboard" style="-fx-text-fill: #f3f4f6; -fx-font-weight: bold;"/>
            </HBox>

            <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-padding: 10 20; -fx-cursor: hand;" onMouseClicked="#refresh">
                <Label text="🎫" style="-fx-font-size: 16px;"/>
                <Label text="Tickets" style="-fx-text-fill: #b9c0cb;"/>
            </HBox>

            <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-padding: 10 20; -fx-cursor: hand;" onMouseClicked="#openCommentaires">
                <Label text="💬" style="-fx-font-size: 16px;"/>
                <Label text="Commentaires" style="-fx-text-fill: #b9c0cb;"/>
            </HBox>

            <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-padding: 10 20; -fx-cursor: hand;" onMouseClicked="#openCalendar">
                <Label text="📅" style="-fx-font-size: 16px;"/>
                <Label text="Calendrier" style="-fx-text-fill: #b9c0cb;"/>
            </HBox>

            <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-padding: 10 20; -fx-cursor: hand;" onMouseClicked="#openStatistiques">
                <Label text="📊" style="-fx-font-size: 16px;"/>
                <Label text="Statistiques" style="-fx-text-fill: #b9c0cb;"/>
            </HBox>

            <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-padding: 10 20; -fx-cursor: hand;" onMouseClicked="#openChatbot">
                <Label text="🤖" style="-fx-font-size: 16px;"/>
                <Label text="Assistant IA" style="-fx-text-fill: #b9c0cb;"/>
            </HBox>



            <Button text="❌ Réinitialiser" onAction="#clearFilters"
                    style="-fx-background-color: transparent; -fx-text-fill: #b9c0cb; -fx-border-color: #4b5563; -fx-border-radius: 8; -fx-padding: 10; -fx-margin: 0 15; -fx-cursor: hand;"/>

            <Region VBox.vgrow="ALWAYS"/>
        </VBox>

        <!-- ========== CONTENU PRINCIPAL ========== -->
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">

            <VBox spacing="20" style="-fx-padding: 25; -fx-background-color: #1f232a;">

                <!-- ========== STATISTIQUES ========== -->
                <GridPane hgap="20" vgap="20">
                    <VBox alignment="CENTER" spacing="8" style="-fx-background-color: #2b3038; -fx-background-radius: 14; -fx-padding: 20; -fx-border-color: #3d4450; -fx-border-radius: 14;"
                          GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="📊" style="-fx-font-size: 32px;"/>
                        <Label fx:id="totalTicketsLabel" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #f3f4f6;"/>
                        <Label text="Total Tickets" style="-fx-font-size: 12px; -fx-text-fill: #b9c0cb;"/>
                    </VBox>

                    <VBox alignment="CENTER" spacing="8" style="-fx-background-color: #2b3038; -fx-background-radius: 14; -fx-padding: 20; -fx-border-color: #3d4450; -fx-border-radius: 14;"
                          GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="📖" style="-fx-font-size: 32px;"/>
                        <Label fx:id="openTicketsLabel" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #f3f4f6;"/>
                        <Label text="Tickets ouverts" style="-fx-font-size: 12px; -fx-text-fill: #b9c0cb;"/>
                    </VBox>

                    <VBox alignment="CENTER" spacing="8" style="-fx-background-color: #2b3038; -fx-background-radius: 14; -fx-padding: 20; -fx-border-color: #3d4450; -fx-border-radius: 14;"
                          GridPane.columnIndex="2" GridPane.rowIndex="0">
                        <Label text="🔄" style="-fx-font-size: 32px;"/>
                        <Label fx:id="progressTicketsLabel" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #f3f4f6;"/>
                        <Label text="En cours" style="-fx-font-size: 12px; -fx-text-fill: #b9c0cb;"/>
                    </VBox>

                    <VBox alignment="CENTER" spacing="8" style="-fx-background-color: #2b3038; -fx-background-radius: 14; -fx-padding: 20; -fx-border-color: #3d4450; -fx-border-radius: 14;"
                          GridPane.columnIndex="3" GridPane.rowIndex="0">
                        <Label text="✅" style="-fx-font-size: 32px;"/>
                        <Label fx:id="resolvedTicketsLabel" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #f3f4f6;"/>
                        <Label text="Résolus" style="-fx-font-size: 12px; -fx-text-fill: #b9c0cb;"/>
                    </VBox>
                </GridPane>

                <!-- ========== FORMULAIRE TICKET ========== -->
                <VBox spacing="12" style="-fx-background-color: #2b3038; -fx-background-radius: 14; -fx-padding: 20; -fx-border-color: #3d4450; -fx-border-radius: 14;">

                    <Label text="✏️ Informations du ticket" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #f3f4f6;"/>

                    <GridPane hgap="15" vgap="12">
                        <Label text="Titre:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: 500; -fx-text-fill: #e5e7eb;"/>
                        <TextField fx:id="titreField" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="400" promptText="Ex: Bug dans l'application..."
                                   style="-fx-background-color: #3a404b; -fx-text-fill: #f3f4f6; -fx-border-color: #4b5563; -fx-border-radius: 8; -fx-padding: 10;"/>

                        <Label text="Description:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: 500; -fx-text-fill: #e5e7eb;"/>

                        <TextArea fx:id="descriptionArea" GridPane.rowIndex="1" GridPane.columnIndex="1"
                                  prefHeight="80" wrapText="true" promptText="Description détaillée..."
                                  style="-fx-background-color: #ffffff; -fx-text-fill: #000000; -fx-prompt-text-fill: #888888; -fx-border-color: #4b5563; -fx-border-radius: 8; -fx-padding: 10;"/>

                        <Label text="Statut:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: 500; -fx-text-fill: #e5e7eb;"/>
                        <ComboBox fx:id="statutCombo" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="200"
                                  style="-fx-background-color: #3a404b; -fx-text-fill: #f3f4f6; -fx-border-color: #4b5563; -fx-border-radius: 8;"/>

                        <Label text="Priorité:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: 500; -fx-text-fill: #e5e7eb;"/>
                        <ComboBox fx:id="prioriteCombo" GridPane.rowIndex="3" GridPane.columnIndex="1" prefWidth="200"
                                  style="-fx-background-color: #3a404b; -fx-text-fill: #f3f4f6; -fx-border-color: #4b5563; -fx-border-radius: 8;"/>
                    </GridPane>

                    <HBox spacing="12" alignment="CENTER_RIGHT">
                        <Button text="➕ Ajouter" onAction="#addTicket"
                                style="-fx-background-color: #4b5563; -fx-text-fill: #f9fafb; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand;"/>
                        <Button text="Modifier" onAction="#updateTicket"
                                style="-fx-background-color: #374151; -fx-text-fill: #f9fafb; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand;"/>
                        <Button text="Supprimer" onAction="#deleteTicket"
                                style="-fx-background-color: #7f1d1d; -fx-text-fill: #f9fafb; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand;"/>
                        <Button text="Effacer" onAction="#clearForm"
                                style="-fx-background-color: #374151; -fx-text-fill: #f9fafb; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand;"/>

                    </HBox>
                </VBox>

                <!-- ========== RECHERCHE ET FILTRES ========== -->
                <VBox spacing="12" style="-fx-background-color: #2b3038; -fx-background-radius: 14; -fx-padding: 20; -fx-border-color: #3d4450; -fx-border-radius: 14;">

                    <Label text="🔍 Recherche et filtres" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #f3f4f6;"/>

                    <GridPane hgap="15" vgap="12">
                        <Label text="Recherche:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: 500; -fx-text-fill: #e5e7eb;"/>
                        <TextField fx:id="searchField" GridPane.rowIndex="0" GridPane.columnIndex="1" promptText="Titre ou description..." prefWidth="350"
                                   style="-fx-background-color: #3a404b; -fx-text-fill: #f3f4f6; -fx-border-color: #4b5563; -fx-border-radius: 8; -fx-padding: 10;" onAction="#searchTickets"/>
                        <Button text="🔍 Rechercher" onAction="#searchTickets" GridPane.rowIndex="0" GridPane.columnIndex="2"
                                style="-fx-background-color: #4b5563; -fx-text-fill: #f9fafb; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand;"/>

                        <Label text="Statut:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: 500; -fx-text-fill: #e5e7eb;"/>
                        <ComboBox fx:id="filterStatutCombo" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="180"
                                  style="-fx-background-color: #3a404b; -fx-text-fill: #f3f4f6; -fx-border-color: #4b5563; -fx-border-radius: 8;"/>

                        <Label text="Priorité:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: 500; -fx-text-fill: #e5e7eb;"/>
                        <ComboBox fx:id="filterPrioriteCombo" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="180"
                                  style="-fx-background-color: #3a404b; -fx-text-fill: #f3f4f6; -fx-border-color: #4b5563; -fx-border-radius: 8;"/>

                        <HBox spacing="12" GridPane.rowIndex="3" GridPane.columnIndex="0" GridPane.columnSpan="2">
                            <Button text="🔄 Rafraîchir" onAction="#refresh"
                                    style="-fx-background-color: #374151; -fx-text-fill: #f9fafb; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand;"/>
                            <Button text="❌ Effacer filtres" onAction="#clearFilters"
                                    style="-fx-background-color: #7f1d1d; -fx-text-fill: #f9fafb; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand;"/>
                        </HBox>
                    </GridPane>
                </VBox>

                <!-- ========== TABLEAU DES TICKETS ========== -->
                <VBox spacing="10" VBox.vgrow="ALWAYS">
                    <Label text="📋 Liste des tickets" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #f3f4f6;"/>

                    <Label text="💡 Double-cliquez sur un ticket pour voir ses commentaires"
                           style="-fx-text-fill: #b9c0cb; -fx-font-size: 11px; -fx-font-style: italic;"/>

                    <TableView fx:id="ticketTable" prefHeight="400"
                               style="-fx-background-color: #2f343e; -fx-background-radius: 10; -fx-border-color: #4b5563; -fx-border-radius: 10;">

                        <columns>
                            <TableColumn fx:id="colId" text="ID" prefWidth="60" resizable="false"/>
                            <TableColumn fx:id="colTitre" text="Titre" prefWidth="450"/>
                            <TableColumn fx:id="colStatut" text="Statut" prefWidth="120"/>
                            <TableColumn fx:id="colPriorite" text="Priorité" prefWidth="120"/>
                            <TableColumn fx:id="colDate" text="Date création" prefWidth="160"/>
                        </columns>

                        <placeholder>
                            <VBox alignment="CENTER" spacing="10" style="-fx-padding: 40;">
                                <Label text="📭" style="-fx-font-size: 48px;"/>
                                <Label text="Aucun ticket trouvé" style="-fx-text-fill: #b9c0cb;"/>
                            </VBox>
                        </placeholder>
                    </TableView>

                    <Label fx:id="lblStats" style="-fx-text-fill: #c5ccd6; -fx-font-size: 11px;"/>
                </VBox>

            </VBox>

        </ScrollPane>

    </HBox>

</VBox>