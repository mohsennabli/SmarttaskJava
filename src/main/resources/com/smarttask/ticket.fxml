<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<BorderPane prefHeight="720.0" prefWidth="1280.0" styleClass="app-root"
            stylesheets="@styles/styles.css" xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.smarttask.controller.TicketController">
    <top>
        <HBox styleClass="top-bar">
            <Label styleClass="app-brand" text="SmartTask"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="currentUserLabel" styleClass="user-label" text=""/>
            <Button onAction="#handleLogout" styleClass="danger-button" text="🚪 Déconnexion"/>
        </HBox>
    </top>
    <left>
        <VBox prefWidth="220.0" styleClass="sidebar">
            <Label styleClass="sidebar-heading" text="Navigation"/>
            <Button onAction="#handleGoToUsers" styleClass="nav-button" text="👥 Utilisateurs"/>
            <Button onAction="#handleGoToProjets" styleClass="nav-button" text="📋 Projets"/>
            <Button onAction="#handleGoToTaches" styleClass="nav-button" text="✅ Tâches"/>
            <Button fx:id="formationsNavBtn" onAction="#handleGoToFormations" styleClass="nav-button" text="🎓 Formations"/>
            <Button onAction="#handleGoToMyEnrollments" styleClass="nav-button" text="📝 Mes Inscriptions"/>
            <Button onAction="#handleGoToTickets" styleClass="nav-button active-nav" text="🎫 Tickets"/>
            <Button onAction="#handleGoToCalendar" styleClass="nav-button" text="📅 Calendrier"/>
            <Button fx:id="statsNavBtn" onAction="#handleGoToStatistiques" styleClass="nav-button" text="📊 Statistiques"/>
            <Button onAction="#handleGoToChatbot" styleClass="nav-button" text="🤖 Chatbot"/>
            <Separator/>
            <Button onAction="#handleProfile" styleClass="nav-button" text="👤 Mon Profil"/>
        </VBox>
    </left>
    <center>
        <ScrollPane fitToWidth="true" styleClass="page-container">
            <VBox spacing="20.0" styleClass="page-card" VBox.vgrow="ALWAYS">
                <GridPane hgap="20" vgap="20">
                    <VBox alignment="CENTER" spacing="8" styleClass="entity-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="📊" style="-fx-font-size: 32px;"/>
                        <Label fx:id="totalTicketsLabel" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #f3f4f6;"/>
                        <Label text="Total Tickets" styleClass="dashboard-subtitle"/>
                    </VBox>
                    <VBox alignment="CENTER" spacing="8" styleClass="entity-card" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="📖" style="-fx-font-size: 32px;"/>
                        <Label fx:id="openTicketsLabel" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #f3f4f6;"/>
                        <Label text="Tickets ouverts" styleClass="dashboard-subtitle"/>
                    </VBox>
                    <VBox alignment="CENTER" spacing="8" styleClass="entity-card" GridPane.columnIndex="2" GridPane.rowIndex="0">
                        <Label text="🔄" style="-fx-font-size: 32px;"/>
                        <Label fx:id="progressTicketsLabel" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #f3f4f6;"/>
                        <Label text="En cours" styleClass="dashboard-subtitle"/>
                    </VBox>
                    <VBox alignment="CENTER" spacing="8" styleClass="entity-card" GridPane.columnIndex="3" GridPane.rowIndex="0">
                        <Label text="✅" style="-fx-font-size: 32px;"/>
                        <Label fx:id="resolvedTicketsLabel" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #f3f4f6;"/>
                        <Label text="Résolus" styleClass="dashboard-subtitle"/>
                    </VBox>
                </GridPane>
                <VBox spacing="12.0" styleClass="entity-card">
                    <Label text="✏️ Informations du ticket" styleClass="section-title"/>
                    <GridPane hgap="15" vgap="12">
                        <Label text="Titre:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="stats-title"/>
                        <TextField fx:id="titreField" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="400" promptText="Ex: Bug dans l'application..." styleClass="form-field"/>
                        <Label text="Description:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="stats-title"/>
                        <TextArea fx:id="descriptionArea" GridPane.rowIndex="1" GridPane.columnIndex="1" prefHeight="80" wrapText="true" promptText="Description détaillée..." styleClass="form-field"/>
                        <Label text="Statut:" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="stats-title"/>
                        <ComboBox fx:id="statutCombo" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="200"/>
                        <Label text="Priorité:" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="stats-title"/>
                        <ComboBox fx:id="prioriteCombo" GridPane.rowIndex="3" GridPane.columnIndex="1" prefWidth="200"/>
                    </GridPane>
                    <HBox spacing="12" alignment="CENTER_RIGHT">
                        <Button text="➕ Ajouter" onAction="#addTicket" styleClass="btn-primary"/>
                        <Button text="Modifier" onAction="#updateTicket" styleClass="btn-outline"/>
                        <Button text="Supprimer" onAction="#deleteTicket" styleClass="btn-danger"/>
                        <Button text="Effacer" onAction="#clearForm" styleClass="btn-outline"/>
                    </HBox>
                </VBox>
                <VBox spacing="12.0" styleClass="entity-card">
                    <Label text="🔍 Recherche et filtres" styleClass="section-title"/>
                    <GridPane hgap="15" vgap="12">
                        <Label text="Recherche:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="stats-title"/>
                        <TextField fx:id="searchField" GridPane.rowIndex="0" GridPane.columnIndex="1" promptText="Titre ou description..." prefWidth="350" styleClass="form-field" onAction="#searchTickets"/>
                        <Button text="🔍 Rechercher" onAction="#searchTickets" GridPane.rowIndex="0" GridPane.columnIndex="2" styleClass="btn-primary"/>
                        <Label text="Statut:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="stats-title"/>
                        <ComboBox fx:id="filterStatutCombo" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="180"/>
                        <Label text="Priorité:" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="stats-title"/>
                        <ComboBox fx:id="filterPrioriteCombo" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="180"/>
                        <HBox spacing="12" GridPane.rowIndex="3" GridPane.columnIndex="0" GridPane.columnSpan="2">
                            <Button text="🔄 Rafraîchir" onAction="#refresh" styleClass="btn-outline"/>
                            <Button text="❌ Effacer filtres" onAction="#clearFilters" styleClass="btn-danger"/>
                        </HBox>
                    </GridPane>
                </VBox>
                <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                    <Label text="📋 Liste des tickets" styleClass="section-title"/>
                    <Label text="💡 Double-cliquez sur un ticket pour voir ses commentaires" styleClass="dashboard-subtitle"/>
                    <TableView fx:id="ticketTable" prefHeight="400" styleClass="table-surface">
                        <columns>
                            <TableColumn fx:id="colId" text="ID" prefWidth="60" resizable="false"/>
                            <TableColumn fx:id="colTitre" text="Titre" prefWidth="240"/>
                            <TableColumn fx:id="colStatut" text="Statut" prefWidth="120"/>
                            <TableColumn fx:id="colPriorite" text="Priorité" prefWidth="120"/>
                            <TableColumn fx:id="colDate" text="Créé le" prefWidth="160"/>
                        </columns>
                    </TableView>
                    <Label fx:id="lblStats" text="Statistiques des tickets" styleClass="stats-title"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
