<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.smarttask.controller.TacheFormController"
      spacing="14" style="-fx-padding: 24;" prefWidth="480">

    <Label fx:id="pageTitle" text="Créer une tâche"
           style="-fx-font-size: 20; -fx-font-weight: bold;"/>

    <Label text="Libellé" style="-fx-font-size: 12; -fx-font-weight: bold;"/>
    <TextField fx:id="libelleField" promptText="Libellé de la tâche"/>
    <Label fx:id="libelleError" style="-fx-text-fill: #d32f2f; -fx-font-size: 11;"/>

    <Label text="Priorité" style="-fx-font-size: 12; -fx-font-weight: bold;"/>
    <ComboBox fx:id="prioriteCombo" prefWidth="Infinity"/>
    <Label fx:id="prioriteError" style="-fx-text-fill: #d32f2f; -fx-font-size: 11;"/>

    <Label text="Date limite" style="-fx-font-size: 12; -fx-font-weight: bold;"/>
    <DatePicker fx:id="dateLimitePicker"/>
    <Label fx:id="dateLimiteError" style="-fx-text-fill: #d32f2f; -fx-font-size: 11;"/>

    <Label text="État" style="-fx-font-size: 12; -fx-font-weight: bold;"/>
    <ComboBox fx:id="etatCombo" prefWidth="Infinity"/>
    <Label fx:id="etatError" style="-fx-text-fill: #d32f2f; -fx-font-size: 11;"/>

    <Label text="Projet" style="-fx-font-size: 12; -fx-font-weight: bold;"/>
    <ComboBox fx:id="projetCombo" prefWidth="Infinity"/>
    <Label fx:id="projetError" style="-fx-text-fill: #d32f2f; -fx-font-size: 11;"/>

    <Region VBox.vgrow="ALWAYS"/>

    <HBox spacing="12" style="-fx-padding: 8 0 0 0;">
        <Button fx:id="saveBtn" text="Enregistrer" onAction="#saveTache"
                style="-fx-padding: 10 24; -fx-font-size: 12; -fx-cursor: hand;"/>
        <Button fx:id="cancelBtn" text="Annuler" onAction="#cancel"
                style="-fx-padding: 10 24; -fx-font-size: 12; -fx-cursor: hand;"/>
    </HBox>
</VBox>
