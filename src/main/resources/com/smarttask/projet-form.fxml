<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.smarttask.controller.ProjetFormController"
      spacing="14" style="-fx-padding: 24;" prefWidth="480">

    <Label fx:id="pageTitle" text="Créer un projet"
           style="-fx-font-size: 20; -fx-font-weight: bold;"/>

    <Label text="Nom du projet" style="-fx-font-size: 12; -fx-font-weight: bold;"/>
    <TextField fx:id="nomField" promptText="Nom du projet"/>
    <Label fx:id="nomError" style="-fx-text-fill: #d32f2f; -fx-font-size: 11;"/>

    <Label text="Description" style="-fx-font-size: 12; -fx-font-weight: bold;"/>
    <TextArea fx:id="descriptionArea" promptText="Description du projet" prefRowCount="4"
              wrapText="true"/>
    <Label fx:id="descriptionError" style="-fx-text-fill: #d32f2f; -fx-font-size: 11;"/>

    <Label text="Date de début" style="-fx-font-size: 12; -fx-font-weight: bold;"/>
    <DatePicker fx:id="dateDebutPicker"/>
    <Label fx:id="dateDebutError" style="-fx-text-fill: #d32f2f; -fx-font-size: 11;"/>

    <Label text="Date d'échéance" style="-fx-font-size: 12; -fx-font-weight: bold;"/>
    <DatePicker fx:id="dateEcheancePicker"/>
    <Label fx:id="dateEcheanceError" style="-fx-text-fill: #d32f2f; -fx-font-size: 11;"/>

    <Label text="Statut" style="-fx-font-size: 12; -fx-font-weight: bold;"/>
    <ComboBox fx:id="statutCombo" prefWidth="Infinity"/>
    <Label fx:id="statutError" style="-fx-text-fill: #d32f2f; -fx-font-size: 11;"/>

    <Region VBox.vgrow="ALWAYS"/>

    <HBox spacing="12" style="-fx-padding: 8 0 0 0;">
        <Button fx:id="saveBtn" text="Enregistrer" onAction="#saveProjet"
                style="-fx-padding: 10 24; -fx-font-size: 12; -fx-cursor: hand;"/>
        <Button fx:id="cancelBtn" text="Annuler" onAction="#cancel"
                style="-fx-padding: 10 24; -fx-font-size: 12; -fx-cursor: hand;"/>
    </HBox>
</VBox>
