<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<BorderPane prefHeight="720.0" prefWidth="1280.0" styleClass="app-root"
            stylesheets="@styles/styles.css" xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.smarttask.controller.CalendarController">
    <top>
        <HBox styleClass="top-bar">
            <Label styleClass="app-brand" text="SmartTask"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="currentUserLabel" styleClass="user-label" text=""/>
            <Button onAction="#handleLogout" styleClass="danger-button" text="🚪 Déconnexion"/>
        </HBox>
    </top>
    <left>
        <VBox prefWidth="220.0" styleClass="sidebar">
            <Label styleClass="sidebar-heading" text="Navigation"/>
            <Button onAction="#handleGoToUsers" styleClass="nav-button" text="👥 Utilisateurs"/>
            <Button onAction="#handleGoToProjets" styleClass="nav-button" text="📋 Projets"/>
            <Button onAction="#handleGoToTaches" styleClass="nav-button" text="✅ Tâches"/>
            <Button fx:id="formationsNavBtn" onAction="#handleGoToFormations" styleClass="nav-button" text="🎓 Formations"/>
            <Button onAction="#handleGoToMyEnrollments" styleClass="nav-button" text="📝 Mes Inscriptions"/>
            <Button onAction="#handleGoToTickets" styleClass="nav-button" text="🎫 Tickets"/>
            <Button onAction="#handleGoToCalendar" styleClass="nav-button active-nav" text="📅 Calendrier"/>
            <Button fx:id="statsNavBtn" onAction="#handleGoToStatistiques" styleClass="nav-button" text="📊 Statistiques"/>
            <Button onAction="#handleGoToChatbot" styleClass="nav-button" text="🤖 Chatbot"/>
            <Separator/>
            <Button onAction="#handleProfile" styleClass="nav-button" text="👤 Mon Profil"/>
        </VBox>
    </left>
    <center>
        <VBox spacing="14.0" styleClass="page-container">
            <VBox spacing="16.0" styleClass="page-card" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER" spacing="20" styleClass="page-header">
                    <Button fx:id="prevMonthBtn" text="◀" styleClass="btn-primary"/>
                    <Label fx:id="monthYearLabel" text="Avril 2026" styleClass="section-title"/>
                    <Button fx:id="nextMonthBtn" text="▶" styleClass="btn-primary"/>
                    <Button fx:id="todayBtn" text="Aujourd'hui" styleClass="btn-outline"/>
                </HBox>
                <HBox spacing="15" alignment="CENTER_LEFT" styleClass="toolbar">
                    <Label text="Filtrer :" styleClass="stats-title"/>
                    <ComboBox fx:id="filterStatusCombo" promptText="Statut" prefWidth="180.0"/>
                    <ComboBox fx:id="filterPriorityCombo" promptText="Priorité" prefWidth="180.0"/>
                </HBox>
                <ScrollPane fitToWidth="true" styleClass="table-surface" VBox.vgrow="ALWAYS">
                    <GridPane fx:id="calendarGrid" hgap="5" vgap="5" alignment="CENTER" styleClass="entity-card">
                        <padding><Insets top="15" bottom="15" left="15" right="15"/></padding>
                    </GridPane>
                </ScrollPane>
            </VBox>
        </VBox>
    </center>
</BorderPane>
