<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" alignment="TOP_CENTER"
      style="-fx-padding: 20; -fx-background-color: #1f232a;"
      stylesheets="@styles/app-theme.css"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.smarttask.controller.CalendarController">

    <!-- ========== HEADER ========== -->
    <HBox alignment="CENTER" spacing="20" style="-fx-background-color: #171a1f; -fx-padding: 15 20; -fx-border-radius: 14; -fx-border-color: #3d4450; -fx-border-width: 0 0 1 0;">
        <Button fx:id="prevMonthBtn" text="◀"
                style="-fx-background-color: #4b5563; -fx-text-fill: #f9fafb; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 8 18; -fx-cursor: hand;"/>
        <Label fx:id="monthYearLabel" text="Avril 2026"
               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #f3f4f6;"/>
        <Button fx:id="nextMonthBtn" text="▶"
                style="-fx-background-color: #4b5563; -fx-text-fill: #f9fafb; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 8 18; -fx-cursor: hand;"/>
        <Button fx:id="todayBtn" text="Aujourd'hui"
                style="-fx-background-color: #374151; -fx-text-fill: #f9fafb; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 8 18; -fx-cursor: hand;"/>
    </HBox>

    <!-- ========== FILTRES ========== -->
    <HBox spacing="15" alignment="CENTER">
        <Label text="Filtrer :" style="-fx-font-weight: bold; -fx-text-fill: #e5e7eb;"/>
        <ComboBox fx:id="filterStatusCombo" promptText="Statut"
                  style="-fx-background-color: #3a404b; -fx-text-fill: #f3f4f6; -fx-border-color: #4b5563; -fx-border-radius: 8; -fx-padding: 6 12;"/>
        <ComboBox fx:id="filterPriorityCombo" promptText="Priorité"
                  style="-fx-background-color: #3a404b; -fx-text-fill: #f3f4f6; -fx-border-color: #4b5563; -fx-border-radius: 8; -fx-padding: 6 12;"/>
    </HBox>

    <!-- ========== CALENDRIER ========== -->
    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
        <GridPane fx:id="calendarGrid" hgap="5" vgap="5" alignment="CENTER"
                  style="-fx-background-color: #2b3038; -fx-background-radius: 14; -fx-padding: 15; -fx-border-color: #3d4450; -fx-border-radius: 14;">
            <padding>
                <Insets top="15" bottom="15" left="15" right="15"/>
            </padding>
        </GridPane>
    </ScrollPane>

</VBox>