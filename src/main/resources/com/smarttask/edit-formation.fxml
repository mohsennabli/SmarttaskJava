<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane minHeight="480.0" minWidth="560.0" prefHeight="640.0" prefWidth="720.0"
            styleClass="app-root" stylesheets="@styles/styles.css" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.smarttask.controller.EditFormationController">
    <children>
        <StackPane styleClass="auth-shell" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                   AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <ScrollPane fitToWidth="true" maxWidth="680.0" style="-fx-background: transparent; -fx-background-color: transparent;">
                <VBox spacing="12.0" styleClass="page-card">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
                    </padding>
                    <Label styleClass="section-title" text="Formation"/>
                    <GridPane hgap="10.0" vgap="10.0">
                        <columnConstraints>
                            <ColumnConstraints minWidth="120.0" prefWidth="140.0"/>
                            <ColumnConstraints hgrow="ALWAYS" minWidth="200.0"/>
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints/>
                            <RowConstraints/>
                            <RowConstraints/>
                            <RowConstraints/>
                            <RowConstraints/>
                            <RowConstraints/>
                            <RowConstraints/>
                            <RowConstraints/>
                            <RowConstraints/>
                            <RowConstraints/>
                        </rowConstraints>
                        <Label text="Title *" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <TextField fx:id="titreField" promptText="Formation title" styleClass="form-field"
                                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <Label text="Description" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <TextArea fx:id="descriptionArea" prefRowCount="4" wrapText="true" styleClass="form-field"
                                  promptText="Optional description" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <Label text="Start date *" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                        <DatePicker fx:id="dateDebutPicker" styleClass="form-field" GridPane.columnIndex="1"
                                    GridPane.rowIndex="2"/>
                        <Label text="End date *" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                        <DatePicker fx:id="dateFinPicker" styleClass="form-field" GridPane.columnIndex="1"
                                    GridPane.rowIndex="3"/>
                        <Label text="Duration (h)" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                        <TextField fx:id="dureeField" promptText="Optional, e.g. 15" styleClass="form-field"
                                   GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                        <Label text="Level *" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                        <TextField fx:id="niveauField" promptText="e.g. debutant" styleClass="form-field"
                                   GridPane.columnIndex="1" GridPane.rowIndex="5"/>
                        <Label text="Category" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
                        <TextField fx:id="categorieField" promptText="Optional" styleClass="form-field"
                                   GridPane.columnIndex="1" GridPane.rowIndex="6"/>
                        <Label text="Status *" GridPane.columnIndex="0" GridPane.rowIndex="7"/>
                        <TextField fx:id="statutField" promptText="e.g. active" styleClass="form-field"
                                   GridPane.columnIndex="1" GridPane.rowIndex="7"/>
                        <Label text="Capacity" GridPane.columnIndex="0" GridPane.rowIndex="8"/>
                        <TextField fx:id="capacityField" promptText="Empty = unlimited" styleClass="form-field"
                                   GridPane.columnIndex="1" GridPane.rowIndex="8"/>
                        <Label text="Google event ID" GridPane.columnIndex="0" GridPane.rowIndex="9"/>
                        <TextField fx:id="googleEventIdField" promptText="Optional" styleClass="form-field"
                                   GridPane.columnIndex="1" GridPane.rowIndex="9"/>
                    </GridPane>
                    <Label styleClass="stats-note"
                           text="* Required. Deleting a formation removes linked enrollments (cascade)."/>
                    <HBox alignment="CENTER_RIGHT" spacing="12.0">
                        <Button fx:id="cancelButton" onAction="#handleCancel" styleClass="secondary-button"
                                text="Cancel"/>
                        <Button fx:id="saveButton" onAction="#handleSave" styleClass="primary-button" text="Save"/>
                    </HBox>
                </VBox>
            </ScrollPane>
        </StackPane>
    </children>
</AnchorPane>
