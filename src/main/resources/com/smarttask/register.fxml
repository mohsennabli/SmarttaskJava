<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane minHeight="600.0" minWidth="900.0" prefHeight="720.0" prefWidth="1280.0"
            styleClass="app-root" stylesheets="@styles/styles.css" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.smarttask.controller.RegisterController">
    <children>
        <StackPane styleClass="auth-shell" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                   AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <VBox alignment="CENTER" prefWidth="420.0" spacing="14.0" styleClass="auth-card">
                <padding>
                    <Insets top="6.0" right="6.0" bottom="6.0" left="6.0"/>
                </padding>
                <Label styleClass="title-text" text="Create Account"/>
                <Label styleClass="subtitle-text" text="Join SmartTask"/>
                <TextField fx:id="nameField" maxWidth="380.0" promptText="Full Name" styleClass="form-field"/>
                <TextField fx:id="emailField" maxWidth="380.0" promptText="Email" styleClass="form-field"/>
                <PasswordField fx:id="passwordField" maxWidth="380.0" promptText="Password" styleClass="form-field"/>
                <ChoiceBox fx:id="typeChoice" maxWidth="380.0" styleClass="form-field"/>
                <Button fx:id="registerButton" maxWidth="380.0" onAction="#handleRegister" styleClass="primary-button" text="Register"/>
                <Hyperlink fx:id="loginLink" onAction="#handleLoginLink" styleClass="link-text" text="Already have an account? Login"/>
            </VBox>
        </StackPane>
    </children>
</AnchorPane>
