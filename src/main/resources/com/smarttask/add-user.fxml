<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane minHeight="420.0" minWidth="560.0" prefHeight="520.0" prefWidth="760.0"
            styleClass="app-root" stylesheets="@styles/styles.css" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.smarttask.controller.AddUserController">
    <children>
        <StackPane styleClass="auth-shell" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                   AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <VBox alignment="CENTER" prefWidth="420.0" spacing="14.0" styleClass="auth-card">
                <padding>
                    <Insets top="6.0" right="6.0" bottom="6.0" left="6.0"/>
                </padding>
                <Label styleClass="section-title" text="Add User"/>
                <TextField fx:id="nameField" maxWidth="380.0" promptText="Full Name" styleClass="form-field"/>
                <TextField fx:id="emailField" maxWidth="380.0" promptText="Email" styleClass="form-field"/>
                <PasswordField fx:id="passwordField" maxWidth="380.0" promptText="Password" styleClass="form-field"/>
                <ChoiceBox fx:id="typeChoice" maxWidth="380.0" prefWidth="380.0" styleClass="form-field"/>
                <HBox alignment="CENTER" spacing="12.0">
                    <Button fx:id="saveButton" onAction="#handleSave" styleClass="primary-button" text="Save"/>
                    <Button fx:id="cancelButton" onAction="#handleCancel" styleClass="secondary-button" text="Cancel"/>
                </HBox>
            </VBox>
        </StackPane>
    </children>
</AnchorPane>

